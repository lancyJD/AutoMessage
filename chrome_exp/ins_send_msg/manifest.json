{
  "manifest_version": 3,
  "name": "SuperDM-SendTest",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "SuperDM — Instagram 批量私信助手。导入用户名列表一键群发，支持发送进度/跳过已发/失败保护、多设备管理与会员授权，安全稳定提升触达效率。",
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "scripting",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "http://43.157.82.128:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "js": [
        "paho-src.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "SuperDM-SendTest",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
