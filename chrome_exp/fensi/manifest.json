{
  "manifest_version": 3,
  "name": "IG 粉丝提取器",
  "description": "无限提取任意 Instagram 博主的粉丝用户名，提取数量可手动输入，一键导出 TXT 文件",
  "version": "2.1.0",
  "action": {
    "default_title": "IG 粉丝提取器"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
